# ==============================================================================
# LexGuard AI - SCM Git Ignore Rules
# ==============================================================================

# Automation Generated Output Directories
Test Results/
Artifacts/
artifacts/
History/
ExecutionResults/
security-audit-reports/
allure-results/
allure-report/

# Generated Temporary Files & Binaries
*.tmp
*.cache
*.bak
*.old
*.coverage

# Exceptions: Retain JSON test data and YAML configs
!*.json
!*.yaml
!*.yml

# Node.js Dependencies & Cache
node_modules/

# Python Virtual Environments & PyCache
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Flutter & Dart Build Output
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Android Build Output & Gradle Cache
android/.gradle/
android/app/build/
android/app/debug/
android/app/profile/
android/app/release/

# Operating System & IDE Files
.DS_Store
Thumbs.db
*.class
*.swp
.idea/

# Backend Secrets & Upload Storage
backend/firebase_credentials.json
firebase_credentials.json
backend/uploads/
backend/vector_db/
backend/scratch/
