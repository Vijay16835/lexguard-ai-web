# ==============================================================================
# LexGuard AI - SCM Git Ignore Rules
# ==============================================================================

# Automation Runtime Generated Output Directories & Files (Ignored in Git)
reports/
Reports/
automation/selenium/reports/
automation/appium/reports/
automation/reports/
Artifacts/
artifacts/
github_artifacts/
Test Results/
ExecutionResults/
security-audit-reports/
allure-results/
allure-report/

# Generated Report Binaries, Screenshots & Execution Logs
*.xlsx
*.xls
*.csv
*.html
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.tiff
*.zip
*.log
*.tmp
*.cache
*.bak
*.old
*.coverage
project_inventory_report.md
final_validation_report.md

# Exception rules: Retain test data and framework configuration files
!automation/**/*.json
!automation/**/*.ts
!automation/**/*.js
!automation/**/*.md
!*.yaml
!*.yml

# Node.js Dependencies & Cache
node_modules/

# Python Virtual Environments & PyCache
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Flutter & Dart Build Output
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Android Build Output & Gradle Cache
android/.gradle/
android/app/build/
android/app/debug/
android/app/profile/
android/app/release/

# Operating System & IDE Files
.DS_Store
Thumbs.db
*.class
*.swp
.idea/

# Backend Secrets & Upload Storage
backend/firebase_credentials.json
firebase_credentials.json
backend/uploads/
