{
  "name": "lexguard-appium-enterprise-automation",
  "version": "2.0.0",
  "description": "Enterprise Android Appium 2.x Automation Framework for LexGuard AI Mobile Application",
  "main": "appium.config.ts",
  "scripts": {
    "test": "wdio run appium.config.ts",
    "test:auth": "wdio run appium.config.ts --spec tests/01_auth_registration.spec.ts",
    "test:dashboard": "wdio run appium.config.ts --spec tests/02_dashboard_navigation.spec.ts",
    "test:ocr": "wdio run appium.config.ts --spec tests/03_document_ocr.spec.ts",
    "test:ai": "wdio run appium.config.ts --spec tests/04_ai_analysis.spec.ts",
    "test:history": "wdio run appium.config.ts --spec tests/05_history_crud.spec.ts",
    "test:settings": "wdio run appium.config.ts --spec tests/06_profile_settings.spec.ts",
    "test:regression": "wdio run appium.config.ts --spec tests/07_offline_accessibility.spec.ts",
    "report": "node utils/report-generator.js",
    "report:excel": "node utils/report-generator.js --excel-only",
    "report:html": "node utils/report-generator.js --html-only"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "android",
    "typescript",
    "lexguard-ai",
    "e2e-testing",
    "mobile-automation"
  ],
  "author": "LexGuard QA Automation Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@wdio/allure-reporter": "^8.24.0",
    "@wdio/appium-service": "^8.24.0",
    "@wdio/cli": "^8.24.0",
    "@wdio/local-runner": "^8.24.0",
    "@wdio/mocha-framework": "^8.24.0",
    "@wdio/spec-reporter": "^8.24.0",
    "appium": "^2.2.3",
    "appium-uiautomator2-driver": "^2.37.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.2.0",
    "mochawesome": "^7.1.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "webdriverio": "^8.24.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0"
  }
}
